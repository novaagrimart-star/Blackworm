# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Server configuration
NODE_ENV=development

# ---------------------------------------------------------------------------
# Automatic Multi-Database Fallback Chain (Server-side, Zero-UI Failover)
# Primary: Firebase + Built-in SQLite WAL Live Sync Server
# ---------------------------------------------------------------------------

# Backup 1: Supabase PostgreSQL REST (Dual-Write + Automatic Failover Read)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backup 2A: Appwrite Databases REST API (Dual-Write + Automatic Failover Read)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_COLLECTION_ID=sync_records

# Backup 2B: MongoDB Atlas Data API (Dual-Write + Automatic Failover Read)
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=
MONGODB_DATA_SOURCE=Cluster0
MONGODB_DATABASE=blackworm_sync
MONGODB_COLLECTION=sync_records

# Backup 3 (Read-Only Fallback): Google Sheets API v4 / Apps Script / GitHub JSON
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_RANGE=sync_records!A1:F5000
GOOGLE_SHEETS_WEBHOOK_URL=
GITHUB_JSON_URL=
GITHUB_TOKEN=
