rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny - Safety First
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for robust access control
    function isSignedIn() { return true; } // Placeholder since we use custom auth
    function isAdmin() { return true; } // Placeholder until real auth is integrated

    // OPEN ACCESS FOR SYNC (Since custom auth doesn't populate request.auth)
    // We prioritize "Central Database Sync" as requested by the user.
    // However, we restrict DELETE to prevent accidental data loss.

    match /users/{userId} {
      allow read, write: if true;
      allow delete: if false; // Data Permanently Safe
    }

    match /dealers_application/{docId} {
      allow read, write: if true;
      allow delete: if false; // Use Soft Delete (isArchived)
    }

    match /orders/{docId} {
      allow read, write: if true;
      allow delete: if false; // Use Soft Delete (isArchived)
    }

    match /collection_entries/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /targets/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /yearly_targets/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /travel_sheets/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }
    
    match /travel_records/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /products_pricelist_v2/{docId} {
      allow read: if true;
      allow write: if true; // Admin managed
    }

    match /products/{docId} {
      allow read, write: if true;
    }

    match /schemes/{docId} {
      allow read, write: if true;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /audit_logs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    match /deleted_records/{docId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /user_approval_requests/{docId} {
      allow read, write: if true;
    }

    match /pricelist_backups/{docId} {
      allow read, write: if true;
    }
    
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
