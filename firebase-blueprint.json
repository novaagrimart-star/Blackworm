{
  "entities": {
    "user": {
      "title": "User",
      "description": "Application users (Admin, Owner, Staff, Dealer, Farmer)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "emailId": { "type": "string" },
        "address": { "type": "string" },
        "designation": { "type": "string" },
        "loginId": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "center": { "type": "string" },
        "userCode": { "type": "string" },
        "allowedModules": { "type": "array" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "loginId", "password"]
    },
    "dealerApplication": {
      "title": "Dealer Application",
      "description": "Detailed dealership registration forms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmName": { "type": "string" },
        "proprietorName": { "type": "string" },
        "dealerCode": { "type": "string" },
        "village": { "type": "string" },
        "district": { "type": "string" },
        "contactNumber": { "type": "string" },
        "officerName": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firmName", "userId"]
    },
    "order": {
      "title": "Order",
      "description": "Sales and payment collection records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "dealerId": { "type": "string" },
        "dealerName": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "totalAmount"]
    },
    "collectionEntry": {
      "title": "Collection Entry",
      "description": "Payment collection records linked to orders or dealers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMode": { "type": "string" },
        "dealerId": { "type": "string" },
        "orderId": { "type": "string" },
        "collectedByUid": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "collectedByUid"]
    },
    "target": {
      "title": "Monthly Target",
      "description": "Monthly performance targets for sales staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "number" },
        "targetSales": { "type": "number" },
        "achievedSales": { "type": "number" },
        "targetCollection": { "type": "number" },
        "achievedCollection": { "type": "number" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "month", "year"]
    },
    "travelSheet": {
      "title": "Travel Sheet",
      "description": "Monthly or daily travel expense summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "officerName": { "type": "string" },
        "monthYear": { "type": "string" },
        "totalKm": { "type": "number" },
        "totalAmount": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId"]
    },
    "auditLog": {
      "title": "Audit Log",
      "description": "Permanent trace of data creation, modifications, and deletions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "collection": { "type": "string" },
        "recordId": { "type": "string" },
        "recordSummary": { "type": "string" },
        "performedByUid": { "type": "string" },
        "performedByName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "collection"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "dealers_application/{docId}": {
      "schema": "dealerApplication",
      "description": "Dealership registration forms"
    },
    "orders/{orderId}": {
      "schema": "order",
      "description": "Sales orders"
    },
    "collection_entries/{docId}": {
      "schema": "collectionEntry",
      "description": "Payment collections"
    },
    "targets/{targetId}": {
      "schema": "target",
      "description": "Monthly targets"
    },
    "travel_sheets/{sheetId}": {
      "schema": "travelSheet",
      "description": "Travel expense summaries"
    },
    "audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Immutable audit trails"
    },
    "config/branding": {
      "schema": "object",
      "description": "Global company branding configuration"
    },
    "deleted_records/{docId}": {
      "schema": "object",
      "description": "Recycle bin for soft-deleted records"
    }
  }
}
