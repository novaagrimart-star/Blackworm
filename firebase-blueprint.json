{
  "entities": {
    "user": {
      "title": "User",
      "description": "Application users (Admin, Owner, Staff, Dealer, Farmer)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "emailId": { "type": "string" },
        "address": { "type": "string" },
        "designation": { "type": "string" },
        "loginId": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "center": { "type": "string" },
        "userCode": { "type": "string" },
        "allowedModules": { "type": "array" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "loginId"]
    },
    "dealerApplication": {
      "title": "Dealer Application",
      "description": "Detailed dealership registration forms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmName": { "type": "string" },
        "proprietorName": { "type": "string" },
        "dealerCode": { "type": "string" },
        "village": { "type": "string" },
        "taluka": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "contactNumber": { "type": "string" },
        "officerName": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firmName", "userId"]
    },
    "order": {
      "title": "Order",
      "description": "Sales and payment collection records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "dealerId": { "type": "string" },
        "dealerName": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "status": { "type": "string" },
        "warehouseStatus": { "type": "string", "enum": ["fresh", "dispatched", "delivered"] },
        "transportName": { "type": "string" },
        "transportDetails": { "type": "string" },
        "dispatchNote": { "type": "string" },
        "warehouseDispatchedAt": { "type": "string", "format": "date-time" },
        "warehouseDispatchedBy": { "type": "string" },
        "warehouseDeliveredAt": { "type": "string", "format": "date-time" },
        "warehouseDeliveredBy": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "totalAmount"]
    },
    "collectionEntry": {
      "title": "Collection Entry",
      "description": "Payment collection records linked to orders or dealers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMode": { "type": "string" },
        "dealerId": { "type": "string" },
        "orderId": { "type": "string" },
        "collectedByUid": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "collectedByUid"]
    },
    "outstandingRecord": {
      "title": "Outstanding Record",
      "description": "Persisted dealer standing amount records from statements or manual entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmName": { "type": "string" },
        "cleanedFirmName": { "type": "string" },
        "amount": { "type": "number" },
        "formattedAmount": { "type": "string" },
        "contactNumber": { "type": "string" },
        "village": { "type": "string" },
        "district": { "type": "string" },
        "proprietorName": { "type": "string" },
        "matchedDealerId": { "type": "string" },
        "sourceFile": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firmName", "amount"]
    },
    "target": {
      "title": "Monthly Target",
      "description": "Monthly performance targets for sales staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "number" },
        "targetSales": { "type": "number" },
        "achievedSales": { "type": "number" },
        "targetCollection": { "type": "number" },
        "achievedCollection": { "type": "number" },
        "ownerId": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "month", "year"]
    },
    "yearlyTarget": {
      "title": "Yearly Target Sheet",
      "description": "Annual financial-year officer target sheets with monthly breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "officerName": { "type": "string" },
        "financialYear": { "type": "string" },
        "center": { "type": "string" },
        "designation": { "type": "string" },
        "months": { "type": "object" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "financialYear"]
    },
    "travelSheet": {
      "title": "Travel Sheet",
      "description": "Monthly or daily travel expense summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "officerName": { "type": "string" },
        "monthYear": { "type": "string" },
        "totalKm": { "type": "number" },
        "totalAmount": { "type": "number" },
        "entries": { "type": "array" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId"]
    },
    "productItem": {
      "title": "Product Price List Item",
      "description": "Company product pricing and pack size metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "packSize": { "type": "string" },
        "dealerRate": { "type": "number" },
        "mrp": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "schemeItem": {
      "title": "Scheme Discount Record",
      "description": "Promotional discount and scheme rules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discountPercent": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "pricelistBackup": {
      "title": "Price List Backup",
      "description": "Historical snapshots of master price list before bulk updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "products": { "type": "array" },
        "createdByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "userApprovalRequest": {
      "title": "User Profile Approval Request",
      "description": "Staff profile edit requests pending Admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetUserName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "proposedData": { "type": "object" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetUserId", "status"]
    },
    "auditLog": {
      "title": "Audit Log",
      "description": "Permanent trace of data creation, modifications, and deletions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "collection": { "type": "string" },
        "recordId": { "type": "string" },
        "recordSummary": { "type": "string" },
        "performedByUid": { "type": "string" },
        "performedByName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "collection"]
    },
    "locationVillage": {
      "title": "Location Village Mapping",
      "description": "Hierarchical State -> District -> Taluka -> Village records linked to dealers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" },
        "stateCode": { "type": "string" },
        "district": { "type": "string" },
        "districtCode": { "type": "string" },
        "taluka": { "type": "string" },
        "talukaCode": { "type": "string" },
        "village": { "type": "string" },
        "villageCode": { "type": "string" },
        "pinCode": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "state", "district", "taluka", "village"]
    },
    "locationTaluka": {
      "title": "Location Taluka Mapping",
      "description": "Admin-added custom talukas mapped under State and District with unique code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" },
        "stateCode": { "type": "string" },
        "district": { "type": "string" },
        "districtCode": { "type": "string" },
        "taluka": { "type": "string" },
        "talukaCode": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "state", "district", "taluka", "talukaCode"]
    },
    "locationDealer": {
      "title": "Location Master Dealer Record",
      "description": "Independent area dealer records maintained inside Location Mapping (separate from dealers_application)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firmName": { "type": "string" },
        "proprietorName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "category": { "type": "string" },
        "state": { "type": "string" },
        "stateCode": { "type": "string" },
        "district": { "type": "string" },
        "districtCode": { "type": "string" },
        "taluka": { "type": "string" },
        "talukaCode": { "type": "string" },
        "village": { "type": "string" },
        "villageCode": { "type": "string" },
        "pinCode": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firmName", "state", "district", "taluka", "village"]
    },
    "officeStaffMember": {
      "title": "Office / Factory Staff Member",
      "description": "Office and Factory staff members managed by Godown Incharge & Admin for daily attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "category": { "type": "string", "enum": ["Office Staff", "Factory Staff"] },
        "workRole": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "joiningDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "linkedUserUid": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "category"]
    },
    "officeStaffAttendance": {
      "title": "Office / Factory Staff Attendance",
      "description": "Daily attendance records for Office Staff & Factory Staff marked by Godown Incharge or Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "monthKey": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "category": { "type": "string", "enum": ["Office Staff", "Factory Staff"] },
        "workRole": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "half_day", "absent", "leave"] },
        "note": { "type": "string" },
        "markedByUid": { "type": "string" },
        "markedByName": { "type": "string" },
        "markedAt": { "type": "string", "format": "date-time" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "staffId", "status"]
    },
    "configDoc": {
      "title": "Global Configuration Document",
      "description": "Shared application configuration (branding, master pricelist, schemes, locks, dealer sequences)",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" },
        "isLocked": { "type": "boolean" },
        "products": { "type": "array" },
        "nextSequence": { "type": "number" }
      }
    },
    "deletedRecord": {
      "title": "Recycle Bin Record",
      "description": "Soft-deleted records retained for audit and recovery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "originalCollection": { "type": "string" },
        "originalId": { "type": "string" },
        "recordData": { "type": "object" },
        "deletedAt": { "type": "string", "format": "date-time" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["id", "originalCollection", "originalId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "location_villages/{docId}": {
      "schema": "locationVillage",
      "description": "Admin-added State -> District -> Taluka -> Village custom location mapping"
    },
    "location_talukas/{docId}": {
      "schema": "locationTaluka",
      "description": "Admin-added State -> District -> Taluka custom subdistrict mapping"
    },
    "location_dealers/{docId}": {
      "schema": "locationDealer",
      "description": "Independent area dealer directory records maintained in Location Mapping"
    },
    "office_staff_members/{docId}": {
      "schema": "officeStaffMember",
      "description": "Office Staff & Factory Staff roster managed by Godown Incharge and Admin"
    },
    "office_staff_attendance/{docId}": {
      "schema": "officeStaffAttendance",
      "description": "Daily attendance records for Office Staff & Factory Staff"
    },
    "dealers_application/{docId}": {
      "schema": "dealerApplication",
      "description": "Dealership registration forms"
    },
    "dealers/{docId}": {
      "schema": "dealerApplication",
      "description": "Legacy dealer records"
    },
    "outstanding_records/{docId}": {
      "schema": "outstandingRecord",
      "description": "Party master & dealer outstanding statement balances"
    },
    "orders/{orderId}": {
      "schema": "order",
      "description": "Sales orders"
    },
    "collection_entries/{docId}": {
      "schema": "collectionEntry",
      "description": "Payment collections"
    },
    "targets/{targetId}": {
      "schema": "target",
      "description": "Monthly targets"
    },
    "yearly_targets/{docId}": {
      "schema": "yearlyTarget",
      "description": "Annual financial-year officer target sheets"
    },
    "travel_sheets/{sheetId}": {
      "schema": "travelSheet",
      "description": "Travel expense summaries"
    },
    "travel_records/{docId}": {
      "schema": "travelSheet",
      "description": "Individual travel expense logs"
    },
    "products_pricelist_v2/{docId}": {
      "schema": "productItem",
      "description": "Product price list collection items"
    },
    "products/{docId}": {
      "schema": "productItem",
      "description": "Legacy product catalog"
    },
    "schemes/{docId}": {
      "schema": "schemeItem",
      "description": "Promotional discount schemes"
    },
    "config/{docId}": {
      "schema": "configDoc",
      "description": "Global config documents (branding, master_pricelist, pricelist_meta, schemes_extra_discounts, party_master_meta, dealer_sequence)"
    },
    "audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Immutable audit trails"
    },
    "deleted_records/{docId}": {
      "schema": "deletedRecord",
      "description": "Recycle bin for soft-deleted records"
    },
    "user_approval_requests/{docId}": {
      "schema": "userApprovalRequest",
      "description": "Pending user profile update approval requests"
    },
    "pricelist_backups/{docId}": {
      "schema": "pricelistBackup",
      "description": "Historical price list backups"
    }
  }
}
